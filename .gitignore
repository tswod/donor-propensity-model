# --- Data ---
# Raw/processed data files - don't commit these (size, and often shouldn't be public anyway)
data/
docs/
*.csv
*.txt
*.zip
!requirements.txt
!README.md

# --- Model artifacts ---
# Trained models can get large fast - track via README instructions instead of committing binaries
*.pkl
*.joblib
*.h5

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Environment/secrets ---
.env
*.env.local

# --- OS/editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Azure ML ---
.azureml/
outputs/